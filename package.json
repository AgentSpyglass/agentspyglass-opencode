{
    "name": "@agentspyglass/opencode",
    "version": "0.1.0",
    "description": "OpenCode plugin that mirrors session/tool events into a native AgentSpyglass window",
    "type": "module",
    "main": "src/index.ts",
    "types": "src/index.ts",
    "scripts": {
        "start": "export AGENTSPYGLASS_DEV=1 && opencode plugin $(pwd) && opencode"
    },
    "files": [
        "src"
    ],
    "dependencies": {
        "@agentspyglass/core": "github:AgentSpyglass/agentspyglass-core",
        "@opencode-ai/plugin": "latest",
        "@opencode-ai/sdk": "^1.18.14"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "@types/node": "^26.2.0",
        "typescript": "^5.6.0"
    }
}
